<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="258.0" prefWidth="340.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.app.Controller">
   <children>
      <ListView fx:id="messageList" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS" />
      <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
         <children>
            <TextArea fx:id="inputArea" prefRowCount="3" HBox.hgrow="ALWAYS" />
            <Button fx:id="fileButton" mnemonicParsing="false" text="F" HBox.hgrow="NEVER" />
            <Button fx:id="sendButton" mnemonicParsing="false" text="S" HBox.hgrow="NEVER" />
         </children>
      </HBox>
   </children>
</VBox>
